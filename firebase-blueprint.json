{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing plan and tier information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "tier": { "type": "string", "enum": ["free", "premium"] },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["email", "tier", "createdAt", "updatedAt"]
    },
    "Resume": {
      "title": "Resume",
      "description": "A generated or saved CV in markdown format",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner of the resume" },
        "title": { "type": "string" },
        "markdown": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "title", "markdown", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile data"
    },
    "/resumes/{resumeId}": {
      "schema": { "$ref": "#/entities/Resume" },
      "description": "Saved resumes"
    }
  }
}
